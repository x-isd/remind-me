# 应用配置
PORT=3000
NODE_ENV=development

# 存储配置
# json     - 本地 JSON 文件（默认，适合 Docker/VPS）
# postgres - PostgreSQL（适合 Vercel 等无持久化文件系统的平台，如 Aiven 免费 PG）
# mysql    - MySQL（如 Aiven 免费 MySQL）
# 不填 STORAGE_TYPE 时会根据 DATABASE_URL 协议自动识别
STORAGE_TYPE=json
# PostgreSQL 示例（Aiven 控制台复制 Service URI 即可）：
# DATABASE_URL=postgres://avnadmin:密码@pg-xxx.aivencloud.com:12345/defaultdb?sslmode=require
# MySQL 示例：
# DATABASE_URL=mysql://avnadmin:密码@mysql-xxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# 调度模式 (internal 或 external)
SCHEDULER_MODE=internal

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PushPlus
PUSHPLUS_TOKEN=

# 邮箱配置 (可选)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# 日志级别 (info, debug, warn, error)
LOG_LEVEL=info

# API 认证 (可选，用于保护 API 端点)
API_KEY=
